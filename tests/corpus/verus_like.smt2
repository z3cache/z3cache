(set-option :auto_config false)
(set-option :smt.mbqi false)
(set-option :smt.case_split 3)
;; module context
(declare-sort T 0)
(declare-fun f (Int) Int)
(declare-fun g (T) Int)
(assert (forall ((x Int)) (! (> (f x) 0) :pattern ((f x)))))
(push)
  (declare-const n Int)
  (assert (not (> (f n) 0)))
(get-info :version)
(set-option :rlimit 30000)
(check-sat)
(set-option :rlimit 0)
(pop)
(echo "<<DONE>>")
(push)
  (declare-const m Int)
  (assert (not (> (f m) 1)))
(set-option :rlimit 30000)
(check-sat)
(set-option :rlimit 0)
(get-model)
(get-value ((f m) m))
(assert (> m 5))
(check-sat)
(pop)
(echo "<<DONE>>")
